# =====================================================
# Конфигурация приложения
# =====================================================
# Скопируйте этот файл в .env и заполните реальными значениями
# cp .env.example .env

# =====================================================
# База данных PostgreSQL
# =====================================================
# Формат: postgresql://username:password@host:port/database_name
# Пример для локальной разработки:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sign_language_dict

# =====================================================
# JWT Аутентификация
# =====================================================
# Секретный ключ для подписи JWT токенов
# ВАЖНО: В production используйте случайную строку длиной не менее 32 символов
# Сгенерировать можно командой: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-in-production-generate-random-string

# Время жизни JWT токена в секундах (по умолчанию 3600 = 1 час)
JWT_EXPIRATION_DELTA=3600

# =====================================================
# Flask Конфигурация
# =====================================================
# Секретный ключ Flask (если не указан, используется JWT_SECRET_KEY)
# SECRET_KEY=your-flask-secret-key

# Режим отладки (True/False)
# В production должно быть False
FLASK_DEBUG=True

# Окружение (development/production)
FLASK_ENV=development

# Порт приложения
FLASK_PORT=5001

# =====================================================
# Хранение видео файлов
# =====================================================
# Тип хранилища: 'local' (локальная файловая система) или 'supabase'
VIDEO_STORAGE_TYPE=local

# Путь для локального хранения видео (относительно корня проекта)
VIDEO_STORAGE_PATH=static/videos

# Базовый URL для доступа к видео
# Для локальной разработки:
VIDEO_BASE_URL=http://localhost:5001/videos
# Для production замените на ваш домен:
# VIDEO_BASE_URL=https://your-domain.com/videos

# =====================================================
# Supabase (опционально, для будущего использования)
# =====================================================
# Если VIDEO_STORAGE_TYPE=supabase, заполните эти параметры:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-key
# SUPABASE_BUCKET=signs

# =====================================================
# Примечания
# =====================================================
# 1. Никогда не коммитьте .env файл в git (он уже в .gitignore)
# 2. Для production:
#    - Используйте сильные случайные ключи
#    - Установите FLASK_DEBUG=False
#    - Установите FLASK_ENV=production
#    - Настройте HTTPS для VIDEO_BASE_URL
# 3. Для разработки можно использовать значения по умолчанию
