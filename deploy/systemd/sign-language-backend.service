[Unit]
Description=Sign Language Dictionary Backend
After=network.target postgresql.service
Requires=network.target

[Service]
Type=notify
User=appuser
Group=appuser
WorkingDirectory=/opt/sign-language-backend
Environment="PATH=/opt/sign-language-backend/venv/bin"
EnvironmentFile=/opt/sign-language-backend/.env
ExecStart=/opt/sign-language-backend/venv/bin/gunicorn \
    --workers 2 \
    --bind 0.0.0.0:5001 \
    --timeout 300 \
    --access-logfile /var/log/app/access.log \
    --error-logfile /var/log/app/error.log \
    --log-level info \
    --worker-class sync \
    "app:create_app()"
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sign-language-backend

[Install]
WantedBy=multi-user.target
