{
  "id": null,
  "uid": "sign-language-sbert-search",
  "title": "SBERT Search",
  "tags": ["sign-language", "search", "sbert", "ml", "logs", "metrics"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "title": "Search Request Rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sign-language"
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(sign_language_search_requests_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 2,
      "title": "P95 Search Duration",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sign-language"
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sign_language_search_duration_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 3,
      "title": "Empty Result Rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sign-language"
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(sign_language_search_empty_results_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "decimals": 2 },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "title": "SBERT Model Status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sign-language"
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sign_language_sbert_model_status",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [
            {
              "options": {
                "0": { "text": "Unavailable" },
                "1": { "text": "Available" }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 5,
      "title": "Search Outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki-sign-language"
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate({service=\"sign-language-backend\", log_type=\"application\", event_name=\"semantic_search\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "title": "Search Duration p50 p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sign-language"
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 5 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(sign_language_search_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(sign_language_search_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "title": "Average And Top Similarity",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki-sign-language"
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "targets": [
        {
          "expr": "avg_over_time({service=\"sign-language-backend\", log_type=\"application\", event_name=\"semantic_search\", outcome=\"success\"} | json | unwrap avg_similarity [5m])",
          "legendFormat": "avg_similarity",
          "refId": "A"
        },
        {
          "expr": "max_over_time({service=\"sign-language-backend\", log_type=\"application\", event_name=\"semantic_search\", outcome=\"success\"} | json | unwrap top_similarity [5m])",
          "legendFormat": "top_similarity",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "title": "Top Search Queries",
      "type": "bargauge",
      "datasource": {
        "type": "loki",
        "uid": "loki-sign-language"
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "topk(12, sum by (query) (count_over_time({service=\"sign-language-backend\", log_type=\"application\", event_name=\"semantic_search\"} | json | query != \"\" [$__range])))",
          "legendFormat": "{{query}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      }
    },
    {
      "id": 9,
      "title": "Embedding Errors Rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-sign-language"
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 },
      "targets": [
        {
          "expr": "sum(rate(sign_language_sbert_embedding_generation_errors_total[5m]))",
          "legendFormat": "embedding_errors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 10,
      "title": "Recent Semantic Search Requests",
      "description": "Показывает текст запроса, results_count, avg_similarity, top_similarity, duration_ms, limit и min_similarity в деталях записи.",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki-sign-language"
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "targets": [
        {
          "expr": "{service=\"sign-language-backend\", log_type=\"application\", event_name=\"semantic_search\"}",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ],
  "style": "dark",
  "templating": { "list": [] },
  "timepicker": {},
  "weekStart": ""
}
