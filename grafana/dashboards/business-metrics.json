{
  "dashboard": {
    "title": "Business Metrics",
    "tags": ["sign-language", "business"],
    "timezone": "browser",
    "schemaVersion": 27,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Sync Check Requests",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(sign_language_sync_check_total[5m])) by (has_updates)",
            "legendFormat": "has_updates={{has_updates}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Full Sync Requests",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "sum(rate(sign_language_sync_data_total[5m]))",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        }
      },
      {
        "id": 3,
        "title": "Sync Data Size",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "sum(rate(sign_language_sync_data_size_bucket[5m])) by (data_type, le)",
            "legendFormat": "{{data_type}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Items"},
          {"format": "short"}
        ]
      },
      {
        "id": 4,
        "title": "Search Requests",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "sum(rate(sign_language_search_requests_total[5m]))",
            "legendFormat": "Search Requests",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Search Duration",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(sign_language_search_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.50, sum(rate(sign_language_search_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "p50",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Seconds"},
          {"format": "short"}
        ]
      },
      {
        "id": 6,
        "title": "Search Results Count",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(sign_language_search_results_count_bucket[5m])) by (le))",
            "legendFormat": "p50 Results",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Results"},
          {"format": "short"}
        ]
      },
      {
        "id": 7,
        "title": "Search Empty Results",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 24},
        "targets": [
          {
            "expr": "sum(rate(sign_language_search_empty_results_total[5m]))",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      },
      {
        "id": 8,
        "title": "Admin Operations",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 6, "y": 24},
        "targets": [
          {
            "expr": "sum(rate(sign_language_admin_sign_operations_total[5m])) by (operation)",
            "legendFormat": "Sign {{operation}}",
            "refId": "A"
          },
          {
            "expr": "sum(rate(sign_language_admin_category_operations_total[5m])) by (operation)",
            "legendFormat": "Category {{operation}}",
            "refId": "B"
          },
          {
            "expr": "sum(rate(sign_language_admin_lesson_operations_total[5m])) by (operation)",
            "legendFormat": "Lesson {{operation}}",
            "refId": "C"
          }
        ],
        "yaxes": [
          {"format": "ops", "label": "Operations/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 9,
        "title": "Video Uploads",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
        "targets": [
          {
            "expr": "sum(rate(sign_language_admin_video_uploads_total[5m])) by (status)",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Uploads/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 10,
        "title": "Admin Auth Attempts",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
        "targets": [
          {
            "expr": "sum(rate(sign_language_admin_auth_attempts_total[5m])) by (status)",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Attempts/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 11,
        "title": "Active Admin Sessions",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 40},
        "targets": [
          {
            "expr": "sign_language_admin_active_sessions",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "value",
          "graphMode": "area"
        }
      }
    ]
  }
}
